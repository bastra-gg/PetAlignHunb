local HUD=require("../src/HologramHUD")
local count=0
local function check(name,callback)
    callback(); count+=1; print("PASS "..name)
end
check("screen center maps to panel center",function()
    local u,v,d=HUD.planeHit(0,0,10,0,0,-1,4,2,0.02)
    assert(u==0.5 and v==0.5 and math.abs(d-9.99)<0.0001)
end)
check("top-left and bottom-right agree with GUI coordinates",function()
    local u,v=HUD.planeHit(-2,1,10,0,0,-1,4,2,0.02)
    assert(u==0 and v==0)
    u,v=HUD.planeHit(2,-1,10,0,0,-1,4,2,0.02)
    assert(u==1 and v==1)
end)
check("rays from behind or outside never click",function()
    assert(HUD.planeHit(0,0,-10,0,0,1,4,2,0.02)==nil)
    assert(HUD.planeHit(0,0,10,0,0,1,4,2,0.02)==nil)
    assert(HUD.planeHit(2.1,0,10,0,0,-1,4,2,0.02)==nil)
    assert(HUD.planeHit(0,0,-10,1,0,0,4,2,0.02)==nil)
end)
check("tilted camera ray hits the same visual button",function()
    local u,v=HUD.planeHit(-3,0,10,0.3,0,-1,4,2,0.02)
    assert(math.abs(u-0.49925)<0.0001 and v==0.5)
end)
check("tap needs a matching release; camera drags are ignored",function()
    local button={}
    assert(HUD.acceptRelease({button=button,x=50,y=50},button,54,52))
    assert(not HUD.acceptRelease({button=button,x=50,y=50},button,75,50))
    assert(not HUD.acceptRelease({button=button,x=50,y=50},{},50,50))
    assert(not HUD.acceptRelease(nil,button,50,50))
    assert(not HUD.acceptRelease({button=button,x=50,y=50,cancelled=true},button,50,50))
end)
check("phone rotation and desktop choose legible layouts",function()
    assert(HUD.layout(390,844)=="portrait")
    assert(HUD.layout(844,390)=="compact")
    assert(HUD.layout(1536,864)=="wide")
end)
print("Hologram geometry/input: "..count.." scenarios passed")
